<tr><td><code>模板:</code></td><td>管理员（视配置）</td><td>docs/layout 等核心模板</td></tr>
<tr><td><code>Docs:</code></td><td>已登录用户</td><td>文档内容页</td></tr>
<tr><td><code>Tool:</code>、主命名空间</td><td>已登录用户</td><td>工具页、内容页</td></tr>
<tr><td><code>文件:</code></td><td>已登录用户</td><td>图片上传需走 SpecialUpload</td></tr>
</table>

