<includeonly>{{rehead
|title={{{title|{{PAGENAME}}}}}
|style=:root{--docs-border:#e6e8eb;--docs-text:#1f2328;--docs-muted:#59636e;--docs-accent:#1f6feb;--docs-bg:#f6f8fa;--docs-sidebar-w:280px}
.docs-layout{min-height:100vh;display:flex;flex-direction:column;background:#fff;color:var(--docs-text)}
.docs-topbar{position:sticky;top:0;z-index:1030;background:#fff;border-bottom:1px solid var(--docs-border)}
.docs-topbar .navbar{min-height:60px}
.docs-topbar .navbar a{text-decoration:none}
.docs-body{display:flex;flex:1;min-height:0}
.docs-sidebar{width:var(--docs-sidebar-w);flex-shrink:0;background:#fff;border-right:1px solid var(--docs-border);padding:1.25rem 1rem;overflow-y:auto}
.docs-group{font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--docs-muted);margin:1.25rem 0 .375rem}
.docs-sidebar .nav{list-style:none;margin:0;padding:0}
.docs-sidebar .nav-item{margin-bottom:2px}
.docs-sidebar .nav a{display:block;color:var(--docs-text);padding:.375rem .625rem;border-radius:6px;text-decoration:none;font-size:.9rem}
.docs-sidebar .nav a:hover{background:var(--docs-bg);color:var(--docs-text)}
.docs-sidebar .nav a.selflink{background:#ddf4ff;color:#0969da;font-weight:600}
.docs-main{flex:1;min-width:0;display:flex;justify-content:center}
.docs-content{max-width:820px;width:100%;padding:2.5rem 2rem 4rem}
.docs-footer{border-top:1px solid var(--docs-border);padding:1.25rem;text-align:center;color:var(--docs-muted);font-size:.85rem;background:#fff}
.docs-footer a{color:var(--docs-muted);text-decoration:none}
.docs-footer a:hover{color:var(--docs-accent)}
.docs-content h2{font-size:1.4rem;font-weight:600;margin:2.25rem 0 .75rem;padding-bottom:.375rem;border-bottom:1px solid var(--docs-border);letter-spacing:-.01em}
.docs-content h3{font-size:1.1rem;font-weight:600;margin:1.5rem 0 .5rem}
.docs-content p{font-size:.95rem;line-height:1.65;color:var(--docs-text)}
.docs-content pre{background:var(--docs-bg);border:1px solid var(--docs-border);border-radius:6px;padding:.875rem 1rem;font-size:.85rem;overflow-x:auto;margin:1rem 0}
.docs-content code{background:var(--docs-bg);border-radius:4px;padding:.125rem .375rem;font-size:.85em;color:#cf222e}
.docs-content pre code{background:none;padding:0;color:var(--docs-text)}
.docs-content ul,.docs-content ol{padding-left:1.5rem;font-size:.95rem;line-height:1.7}
.docs-content li{margin-bottom:.25rem}
.docs-content table{width:100%;border-collapse:collapse;margin:1rem 0;font-size:.9rem}
.docs-content th,.docs-content td{border:1px solid var(--docs-border);padding:.5rem .75rem;text-align:left}
.docs-content th{background:var(--docs-bg);font-weight:600}
.docs-content blockquote{border-left:4px solid var(--docs-border);padding:.25rem 1rem;color:var(--docs-muted);margin:1rem 0}
.docs-content ul.timeline{padding-left:0;list-style:none}
.docs-content .timeline li{margin-bottom:0}
.docs-content .timeline h3{margin:0 0 .25rem}
.docs-content .timeline p{margin:0}
.docs-content .alert p{margin:0}
@media (max-width:767px){
.docs-body{flex-direction:column}
.docs-sidebar{width:auto;border-right:0;border-bottom:1px solid var(--docs-border);padding:.75rem 1rem;overflow-y:visible}
.docs-group{margin:.5rem 0 .25rem}
.docs-sidebar .nav{display:flex;flex-wrap:wrap;gap:.25rem}
.docs-sidebar .nav-item{margin:0}
.docs-sidebar .nav a{padding:.25rem .625rem;font-size:.85rem}
.docs-content{padding:1.25rem 1rem 3rem;overflow-wrap:anywhere}
.docs-content h2{font-size:1.25rem;margin-top:1.75rem}
.docs-content table{display:block;overflow-x:auto;width:auto;max-width:100%}
.docs-content th,.docs-content td{overflow-wrap:normal}
}
}}

{{libs
|css=daisyui
|daisyui=navbar,menu,button,dropdown,alert,timeline,card
|js=tailwind
|cleanup=true
|rehead=true
}}

<div class="docs-layout">
<div class="docs-topbar">
{{Navbar}}
</div>
<div class="docs-body">
{{#invoke:DocsNav|sidebar}}
<div class="docs-main">
<div class="docs-content">
</includeonly><noinclude>
{{Documentation}}

; 用途
: 文档页面的公共外壳模板（GitBook 风格，daisyUI）。顶部使用默认导航栏 {{Navbar}}（logo + 搜索 + 更多，无文档选项），左侧目录侧边栏，窄栏内容区。
: 搭配 <nowiki>{{docs/end}}</nowiki> 使用（该模板负责闭合容器并输出页脚）。

; 用法
: 在文档页面顶部写入：

<pre>
{{docs/layout}}

...页面正文...

{{docs/end}}
</pre>

; 说明
: 本模板已内置 <nowiki>{{libs}}</nowiki>（daisyui + tailwind）与 <nowiki>{{rehead}}</nowiki> 声明，文档页无需重复添加。
: 顶部导航栏使用默认 {{Navbar}}（无文档选项），侧边栏菜单由 [[Docs:navigation]] 驱动（通过 [[Module:DocsNav]] 读取），当前页自动高亮。
: 正文可用 daisyUI 组件：<code>alert</code>（提示框）、<code>timeline</code>（步骤/FAQ）、<code>card</code>（卡片）。
: 注意：本站 MediaWiki 不允许 wikitext 中使用 <code>&lt;a&gt;</code> 标签（会被转义），
: 顶部链接与侧边栏一律使用 <code>[[链接]]</code> wikitext 语法，样式通过 CSS 选择器控制。
</noinclude>
